{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lablens.local/schemas/ocr_hardware_profile.v1.json",
  "title": "LabLens OCR Hardware Profile",
  "description": "Machine-independent record produced by docs/development/phase-8.1/ocr_hardware_profile.py. Measured results, hardware-detection results, reused prior measurements, recommendations and untested configurations are kept strictly separate. No hostnames, usernames, MAC addresses, serial numbers or personal file paths are permitted in any field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "tool",
    "generated_at",
    "hardware",
    "memory",
    "runtime",
    "model",
    "gpu",
    "adaptive_candidates",
    "prior_evidence",
    "experiments",
    "safety",
    "db_integrity",
    "recommendations",
    "untested"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "phase": { "type": "string", "minLength": 1 },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "lablens-ocr-profiler" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },

    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "nvidia", "other_accelerators"],
      "properties": {
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "architecture",
            "bits",
            "physical_cores",
            "logical_cores",
            "frequency_mhz",
            "capabilities",
            "capabilities_source"
          ],
          "properties": {
            "model": { "type": "string" },
            "architecture": { "type": "string" },
            "bits": { "type": "integer", "enum": [32, 64] },
            "physical_cores": { "type": "integer", "minimum": 1 },
            "logical_cores": { "type": "integer", "minimum": 1 },
            "frequency_mhz": { "type": ["number", "null"] },
            "capabilities": { "type": "array", "items": { "type": "string" } },
            "capabilities_source": { "type": ["string", "null"] }
          }
        },
        "nvidia": {
          "type": "object",
          "additionalProperties": false,
          "required": ["present", "name", "driver_version", "vram_bytes", "source"],
          "properties": {
            "present": { "type": "boolean" },
            "name": { "type": ["string", "null"] },
            "driver_version": { "type": ["string", "null"] },
            "vram_bytes": { "type": ["integer", "null"], "minimum": 0 },
            "source": { "type": ["string", "null"], "description": "nvidia-smi | wmi | null (not discoverable)" }
          }
        },
        "other_accelerators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "model", "driver_version"],
            "properties": {
              "kind": { "type": "string", "enum": ["integrated_gpu", "discrete_gpu", "npu", "tpu", "other"] },
              "model": { "type": "string" },
              "driver_version": { "type": ["string", "null"] }
            }
          }
        }
      }
    },

    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_bytes", "available_bytes"],
      "properties": {
        "total_bytes": { "type": "integer", "minimum": 1 },
        "available_bytes": { "type": "integer", "minimum": 0 }
      }
    },

    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "python", "packages", "paddle_devices"],
      "properties": {
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "architecture"],
          "properties": {
            "system": { "type": "string" },
            "architecture": { "type": "string" }
          }
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {
            "version": { "type": "string" }
          }
        },
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paddlepaddle", "paddleocr", "paddlex"],
          "properties": {
            "paddlepaddle": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "compiled_with_cuda", "cuda_version", "cudnn_version"],
              "properties": {
                "version": { "type": "string" },
                "compiled_with_cuda": { "type": "boolean" },
                "cuda_version": { "type": ["string", "null"] },
                "cudnn_version": { "type": ["string", "null"] }
              }
            },
            "paddleocr": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version"],
              "properties": {
                "version": { "type": ["string", "null"] }
              }
            },
            "paddlex": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version"],
              "properties": {
                "version": { "type": ["string", "null"] }
              }
            }
          }
        },
        "paddle_devices": { "type": "array", "items": { "type": "string" } }
      }
    },

    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_detection_model",
        "text_recognition_model",
        "detection_limit_side_len",
        "detection_limit_type",
        "precision",
        "mkl_dnn_enabled",
        "cpu_threads_default",
        "recognition_batch_size_default",
        "cache_dir",
        "cache_total_bytes",
        "production_config_source"
      ],
      "properties": {
        "text_detection_model": { "type": ["string", "null"] },
        "text_recognition_model": { "type": ["string", "null"] },
        "detection_limit_side_len": { "type": ["integer", "null"] },
        "detection_limit_type": { "type": ["string", "null"], "enum": ["max", "min", null] },
        "precision": { "type": "string" },
        "mkl_dnn_enabled": { "type": "boolean" },
        "cpu_threads_default": { "type": ["integer", "null"] },
        "recognition_batch_size_default": { "type": ["integer", "null"] },
        "cache_dir": { "type": "string", "const": "~/.paddlex/official_models" },
        "cache_total_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "production_config_source": { "type": "string" }
      }
    },

    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hardware_present",
        "runtime_compatible",
        "devices",
        "cuda_version",
        "cudnn_version",
        "smoke_test",
        "performance_status",
        "performance_reason",
        "fallback"
      ],
      "properties": {
        "hardware_present": { "type": "boolean" },
        "runtime_compatible": { "type": "boolean" },
        "devices": { "type": "array", "items": { "type": "string" } },
        "cuda_version": { "type": ["string", "null"] },
        "cudnn_version": { "type": ["string", "null"] },
        "smoke_test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "backend",
            "init_seconds",
            "inference_seconds",
            "error_type",
            "error_message",
            "workload"
          ],
          "properties": {
            "status": { "type": "string", "enum": ["passed", "failed", "not_run", "skipped_incompatible"] },
            "backend": { "type": ["string", "null"] },
            "init_seconds": { "type": ["number", "null"], "minimum": 0 },
            "inference_seconds": { "type": ["number", "null"], "minimum": 0 },
            "error_type": { "type": ["string", "null"] },
            "error_message": { "type": ["string", "null"] },
            "workload": { "type": ["string", "null"] }
          }
        },
        "performance_status": { "type": "string", "enum": ["measured", "untested"] },
        "performance_reason": { "type": ["string", "null"] },
        "fallback": { "type": ["string", "null"], "enum": ["cpu", null] }
      }
    },

    "adaptive_candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_cores",
        "physical_cores",
        "cpu_threads",
        "recognition_batch_size",
        "selection_method",
        "fixed_constraints"
      ],
      "properties": {
        "logical_cores": { "type": "integer", "minimum": 1 },
        "physical_cores": { "type": "integer", "minimum": 1 },
        "cpu_threads": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "recognition_batch_size": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "enum": [1, 2, 4, 6] }
        },
        "selection_method": { "type": "string" },
        "fixed_constraints": { "type": "string" }
      }
    },

    "prior_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "phase", "results_file", "measured_on", "note"],
      "properties": {
        "available": { "type": "boolean" },
        "phase": { "type": "string" },
        "results_file": { "type": ["string", "null"] },
        "measured_on": { "type": ["string", "null"] },
        "note": { "type": "string" }
      }
    },

    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "parameters", "status", "skip_reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cpu_threads", "text_recognition_batch_size", "device"],
            "properties": {
              "cpu_threads": { "type": ["integer", "null"], "minimum": 1 },
              "text_recognition_batch_size": { "type": ["integer", "null"], "minimum": 1 },
              "device": { "type": "string", "enum": ["cpu", "gpu"] }
            }
          },
          "status": { "type": "string", "enum": ["measured", "skipped", "failed"] },
          "skip_reason": { "type": ["string", "null"] },
          "fixture": { "type": ["string", "null"] },
          "init_seconds": { "type": ["number", "null"], "minimum": 0 },
          "cold_inference_seconds": { "type": ["number", "null"], "minimum": 0 },
          "warm_inference_seconds": { "type": ["number", "null"], "minimum": 0 },
          "total_extraction_seconds": { "type": ["number", "null"], "minimum": 0 },
          "ocr_call_count": { "type": ["integer", "null"], "minimum": 0 },
          "peak_rss_bytes": { "type": ["integer", "null"], "minimum": 0 },
          "accuracy": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["biomarker_recall", "biomarker_precision", "correctly_identified_tests", "extracted_count", "ground_truth_count", "mismatch_count"],
            "properties": {
              "biomarker_recall": { "type": "number", "minimum": 0, "maximum": 1 },
              "biomarker_precision": { "type": "number", "minimum": 0, "maximum": 1 },
              "correctly_identified_tests": { "type": "integer", "minimum": 0 },
              "extracted_count": { "type": "integer", "minimum": 0 },
              "ground_truth_count": { "type": "integer", "minimum": 0 },
              "mismatch_count": { "type": "integer", "minimum": 0 }
            }
          },
          "page_attribution": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["correct", "scored"],
            "properties": {
              "correct": { "type": "integer", "minimum": 0 },
              "scored": { "type": "integer", "minimum": 0 }
            }
          },
          "source_coordinates_valid": { "type": ["boolean", "null"] }
        }
      }
    },

    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_available_required_bytes",
        "stop_reserve_bytes",
        "preflight_available_bytes",
        "precondition_met",
        "memory_guard_triggered",
        "sequential_execution",
        "workers_launched",
        "skipped_experiments"
      ],
      "properties": {
        "min_available_required_bytes": { "type": "integer", "const": 1610612736 },
        "stop_reserve_bytes": { "type": "integer", "const": 786432000 },
        "preflight_available_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "precondition_met": { "type": "boolean" },
        "memory_guard_triggered": { "type": "boolean" },
        "sequential_execution": { "type": "boolean", "const": true },
        "workers_launched": { "type": "integer", "minimum": 0 },
        "skipped_experiments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason"],
            "properties": {
              "id": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },

    "db_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "db_sha256_before",
        "db_sha256_after",
        "upload_file_count_before",
        "upload_file_count_after",
        "report_rows",
        "unchanged"
      ],
      "properties": {
        "db_sha256_before": { "type": ["string", "null"] },
        "db_sha256_after": { "type": ["string", "null"] },
        "upload_file_count_before": { "type": "integer", "minimum": 0 },
        "upload_file_count_after": { "type": "integer", "minimum": 0 },
        "report_rows": { "type": ["integer", "null"], "minimum": 0 },
        "unchanged": { "type": "boolean" }
      }
    },

    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "text", "evidence_class", "based_on"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "enum": ["cpu", "gpu", "memory", "model", "overall"] },
          "text": { "type": "string", "minLength": 1 },
          "evidence_class": { "type": "string", "const": "recommendation" },
          "based_on": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "untested": { "type": "array", "items": { "type": "string" } }
  }
}
