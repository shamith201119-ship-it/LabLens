# ── Node / frontend ──────────────────────────────────────────
node_modules/
dist/
.cache/
.eslintcache
*.local

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
backend/.pytest_cache/
.venv/
venv/

# ── LabLens runtime state (private user data) ───────────────
