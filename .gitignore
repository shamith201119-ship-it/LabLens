backend/data/
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── Environment / secrets ────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── OS / editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*.swn
.history/

# ── Logs & temp ──────────────────────────────────────────────
*.log
logs/
tmp/
temp/
coverage/
